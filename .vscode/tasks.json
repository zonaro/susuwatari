{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Abrir Susuwatari no Navegador",
			"type": "shell",
			"command": "Start-Process",
			"args": [
				"index.html"
			],
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Copiar para Wallpaper Engine",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"copy-to-wallpaper-engine.ps1"
			],
			"isBackground": false,
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": false
			},
			"problemMatcher": []
		}
	]
}